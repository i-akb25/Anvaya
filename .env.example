# Local development review only; production ignores this preview flag.
NEXT_PUBLIC_ANVAYA_DRAFT_PREVIEW=false

# Private account/sync stays OFF until explicitly enabled and configured.
ANVAYA_CLOUD_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
ANVAYA_OWNER_ID=
ANVAYA_APP_ORIGIN=

# Optional tutor. Keep OFF for local-only use. Requires authenticated owner,
# the tutor-budget SQL migration and an explicitly selected Gemini model.
ANVAYA_TUTOR_ENABLED=false
GEMINI_API_KEY=
ANVAYA_GEMINI_MODEL=
